{
  "name": "banking-engine/app",
  "type": "project",
  "description": "Dynamic banking calculation and governance engine",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "filament/filament": "^5.0",
    "livewire/livewire": "^4.0",
    "symfony/expression-language": "^8.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.26",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {"App\\": "app/"}
  },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
